# The registry (sites.json) is only ever read through api.php's session-gated
# "status" action — never served as a plain file.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  <IfModule mod_authz_host.c>
    Order allow,deny
    Deny from all
  </IfModule>
</IfModule>
